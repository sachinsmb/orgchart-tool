# Copy to .env at the repo root, then `ln -s ../../.env app/backend/.env` so compose picks it up.
# Generate real values on the server; never commit the filled-in file.
POSTGRES_USER=acme
POSTGRES_PASSWORD=change-me
POSTGRES_DB=acmeorg
DATABASE_URL=postgresql://acme:change-me@db:5432/acmeorg
JWT_SECRET=change-me            # e.g. `openssl rand -hex 32`
ADMIN_EMAIL=admin@acmemep.local # first admin login, created on an empty users table
ADMIN_NAME=Admin
ADMIN_PASSWORD=change-me
